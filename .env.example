# ---- Public (safe in the browser) ----
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=HelloMe
# Sites are served at <slug>.<root domain>. Dev: localhost:3000 (browsers resolve *.localhost).
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# ---- Server only (never prefix with NEXT_PUBLIC_) ----
SUPABASE_SERVICE_ROLE_KEY=
# HMAC secret for privacy-preserving visitor hashes. Long random string.
ANALYTICS_SALT=

# AI providers (docs/AI_ARCHITECTURE.md). Keys are read by name from ai_providers.api_key_env.
NVIDIA_API_KEY=
XAI_API_KEY=
# Allow the mock provider when no real provider is configured. Never true in production.
AI_ALLOW_MOCK=false

# Billing (docs/BILLING_ARCHITECTURE.md): dev | razorpay | none
BILLING_PROVIDER=none
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Custom domains: the CNAME target customers point their domain at.
CUSTOM_DOMAIN_CNAME_TARGET=cname.hellome.in
